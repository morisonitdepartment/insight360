# Application mode: "demo" (no backend, seeded data) or "live" (Supabase)
VITE_APP_MODE=demo

# Supabase (Live Mode only). Only the public anon key belongs here.
# NEVER put the service-role key in any frontend configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base path for GitHub Pages project sites, e.g. /insight360/
# Leave empty for local development (defaults to /insight360/ in production builds).
VITE_BASE_PATH=

# ---------------------------------------------------------------------------
# Test accounts for scripts/check-role-scoping.mjs (optional, local only).
# Leave blank here. Put the real passwords in .env, which is git-ignored.
# These are throwaway QA logins, never a real employee's credentials.
# ---------------------------------------------------------------------------
TEST_OPS_EMAIL=
TEST_OPS_PASSWORD=
TEST_SHOPPER_EMAIL=
TEST_SHOPPER_PASSWORD=
TEST_EXEC_EMAIL=
TEST_EXEC_PASSWORD=
TEST_ANALYST_EMAIL=
TEST_ANALYST_PASSWORD=
