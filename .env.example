# Application mode: "demo" (no backend, seeded data) or "live" (Supabase)
VITE_APP_MODE=demo

# Supabase (Live Mode only). Only the public anon key belongs here.
# NEVER put the service-role key in any frontend configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base path for GitHub Pages project sites, e.g. /insight360/
# Leave empty for local development (defaults to /insight360/ in production builds).
VITE_BASE_PATH=
