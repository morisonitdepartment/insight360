{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "insight360-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "hermanos-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        "dist/hermanos",
        "--base",
        "/insight360/hermanos/",
        "--port",
        "4181",
        "--strictPort"
      ],
      "port": 4181,
      "url": "http://localhost:4181"
    },
    {
      "name": "sterling-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        "dist",
        "--base",
        "/insight360/",
        "--port",
        "4182",
        "--strictPort"
      ],
      "port": 4182,
      "url": "http://localhost:4182"
    }
  ]
}
